# HeatShield Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with actual credentials.

# OpenWeather API Key (Get from https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenWeather API Base URL
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Server & HTTP Configuration
PORT=8000
HOST=127.0.0.1
HTTP_TIMEOUT_SECONDS=10
